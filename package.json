{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "env:pull": "npx dotenv-vault@latest pull && npx dotenv-vault@latest pull staging && npx dotenv-vault@latest pull production",
    "env:push": "npx dotenv-vault@latest push && npx dotenv-vault@latest push staging && npx dotenv-vault@latest push production",
    "dev:local": "env-cmd -f .env next dev",
    "dev": "env-cmd -f .env.staging next dev",
    "dev:prod": "env-cmd -f .env.production next dev",
    "build:local": "env-cmd -f .env next build",
    "build:dev": "env-cmd -f .env.staging next build",
    "build:prod": "env-cmd -f .env.production next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky install"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.3",
    "@tanstack/react-query-devtools": "^5.66.3",
    "env-cmd": "^10.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@iconify/react": "^5.2.0",
    "@mui/icons-material": "^6.4.4",
    "@mui/material": "^6.4.4",
    "@types/kakao-js-sdk": "^1.39.5",
    "cookies-next": "^5.1.0",
    "ky": "^1.7.5",
    "next": "15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.4.0",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.66.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "eslint-plugin-unicorn": "^53.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "msw": "^2.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@9.8.0+sha512.8e4c3550fb500e808dbc30bb0ce4dd1eb614e30b1c55245f211591ec2cdf9c611cabd34e1364b42f564bd54b3945ed0f49d61d1bbf2ec9bd74b866fcdc723276"
}
